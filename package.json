{
  "name": "eventsnap",
  "version": "0.1.0",
  "overrides": {
    "fast-xml-parser": "5.3.8"
  },
  "private": true,
  "scripts": {
    "dev": "bun run with-secrets.ts next dev",
    "build": "bun run with-secrets.ts next build",
    "start": "bun run with-secrets.ts next start",
    "lint": "bun run with-secrets.ts next lint",
    "postinstall": "bun run with-secrets.ts prisma generate",
    "db:push": "bun run with-secrets.ts prisma db push",
    "db:migrate": "bun run with-secrets.ts prisma migrate deploy",
    "db:studio": "bun run with-secrets.ts prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@prisma/adapter-pg": "^7.9.1",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.460.0",
    "next": "^16.3.1",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@prisma/client": "^7.9.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@2.30.3": true,
    "es5-ext@0.10.64": true,
    "unrs-resolver@1.11.1": true,
    "sharp@0.34.5": true
