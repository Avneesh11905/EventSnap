# ==========================================
# ⚠️ IMPORTANT: NEXT.JS DOES NOT READ THIS FILE
# To use these variables, you must COPY this file to `.env` or `.env.local`
# ==========================================

# ==========================================
# 🔐 Option 1A: Use Infisical Service Token (Simple)
# ==========================================
# Just provide your static Service Token. The app will securely fetch 
# all other secrets into memory automatically!
#
# INFISICAL_API_URL=https://secrets.aymahajan.in
# INFISICAL_TOKEN=st.your-token-here

# ==========================================
# 🔐 Option 1B: Use Infisical Machine Identity (More Secure)
# ==========================================
# If using Universal Auth (Machine Identities), provide these variables instead:
#
# INFISICAL_API_URL=https://secrets.aymahajan.in
# INFISICAL_CLIENT_ID=your-machine-client-id
# INFISICAL_CLIENT_SECRET=your-machine-client-secret
# INFISICAL_WORKSPACE_ID=your-project-workspace-id
# INFISICAL_ENVIRONMENT=dev

# ==========================================
# 📝 Option 2: Use Direct Environment Variables
# ==========================================
# If you are NOT using Infisical, you must define all the variables below.
# The app will detect that there is no Infisical token and will fallback to 
# reading these local variables natively.

# PostgreSQL Connection String (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key # Generate with: openssl rand -base64 32

# OAuth — Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ML Model API / Backend Orchestrator
NEXT_PUBLIC_INFERENCE_API_URL=http://localhost:8000

# MinIO (S3-compatible storage)
STORAGE_ENDPOINT=http://your-minio-endpoint
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET_NAME=your-bucket-name
